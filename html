<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Temperature Converter</title>

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">

<style>

/* RESET */
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:'Poppins',sans-serif;
}

/* BACKGROUND */
body{
    min-height:100vh;
    display:flex;
    justify-content:center;
    align-items:center;

    overflow:hidden;
    position:relative;

    background:linear-gradient(-45deg,
        #0a0014,
        #1a0033,
        #12002a,
        #0b0b22
    );

    background-size:400% 400%;
    animation:bgMove 12s ease infinite;
}

/* animated background */
@keyframes bgMove{
    0%{background-position:0% 50%;}
    50%{background-position:100% 50%;}
    100%{background-position:0% 50%;}
}

/* neon purple glow blobs */
body::before{
    content:"";
    position:absolute;
    width:500px;
    height:500px;

    left:-150px;
    top:-150px;

    background:radial-gradient(circle,
        rgba(168,85,247,.5),
        transparent 60%
    );

    filter:blur(60px);
    opacity:.8;
}

body::after{
    content:"";
    position:absolute;
    width:500px;
    height:500px;

    right:-150px;
    bottom:-150px;

    background:radial-gradient(circle,
        rgba(236,72,153,.35),
        transparent 60%
    );

    filter:blur(60px);
    opacity:.7;
}

/* CONTAINER */
.container{
    width:90%;
    max-width:430px;

    padding:35px;

    border-radius:25px;

    background:rgba(255,255,255,.06);
    backdrop-filter:blur(22px);

    border:1px solid rgba(168,85,247,.25);

    box-shadow:
        0 0 25px rgba(168,85,247,.25),
        0 25px 60px rgba(0,0,0,.5);

    text-align:center;
    color:white;

    animation:appear .8s ease;
    transition:.4s;
}

.container:hover{
    transform:translateY(-6px);
    box-shadow:
        0 0 40px rgba(168,85,247,.35),
        0 0 80px rgba(236,72,153,.15),
        0 30px 70px rgba(0,0,0,.6);
}

@keyframes appear{
    from{opacity:0;transform:translateY(30px);}
    to{opacity:1;transform:translateY(0);}
}

/* ICON */
.icon{
    font-size:70px;
    margin-bottom:10px;

    filter:drop-shadow(0 0 15px rgba(168,85,247,.8));
    animation:floatIcon 3s ease-in-out infinite;
}

@keyframes floatIcon{
    0%,100%{transform:translateY(0);}
    50%{transform:translateY(-6px);}
}

/* TITLE */
h1{
    font-size:30px;
    margin-bottom:8px;

    background:linear-gradient(90deg,#a855f7,#ec4899,#60a5fa);
    -webkit-background-clip:text;
    -webkit-text-fill-color:transparent;
}

/* SUBTITLE */
.subtitle{
    color:#c4b5fd;
    margin-bottom:25px;
    font-size:14px;
}

/* INPUTS */
input,
select{
    width:100%;
    padding:15px;
    margin:12px 0;

    border-radius:14px;
    border:1px solid rgba(168,85,247,.3);

    background:rgba(255,255,255,.05);

    color:white;
    font-size:15px;

    outline:none;
    transition:.3s;
}

/* placeholder */
input::placeholder{
    color:#c4b5fd;
}

/* options */
option{
    color:black;
}

/* hover */
input:hover,
select:hover{
    border-color:rgba(236,72,153,.6);
}

/* focus glow */
input:focus,
select:focus{
    transform:translateY(-2px);

    box-shadow:
        0 0 0 3px rgba(168,85,247,.15),
        0 0 25px rgba(236,72,153,.35);
}

/* BUTTON */
button{
    width:100%;
    padding:15px;
    margin-top:10px;

    border:none;
    border-radius:14px;

    background:linear-gradient(135deg,#a855f7,#ec4899,#60a5fa);

    color:white;

    font-size:16px;
    font-weight:600;

    cursor:pointer;

    transition:.3s;

    box-shadow:0 0 25px rgba(168,85,247,.25);
}

button:hover{
    transform:translateY(-3px);
    box-shadow:0 0 40px rgba(236,72,153,.35);
}

button:active{
    transform:scale(.98);
}

/* RESULT */
.result{
    margin-top:20px;
    padding:20px;

    min-height:80px;

    display:flex;
    justify-content:center;
    align-items:center;

    border-radius:16px;

    background:rgba(255,255,255,.05);

    border:1px solid rgba(168,85,247,.2);

    font-size:28px;
    font-weight:700;

    color:#a855f7;

    text-shadow:0 0 10px rgba(168,85,247,.4);
}

/* animation */
.show{
    animation:fadeIn .4s ease;
}

@keyframes fadeIn{
    from{opacity:0;transform:translateY(10px);}
    to{opacity:1;transform:translateY(0);}
}

/* MOBILE */
@media(max-width:480px){
    .container{
        padding:25px;
    }

    h1{
        font-size:24px;
    }

    .result{
        font-size:24px;
    }
}

</style>
</head>

<body>

<div class="container">

    <div class="icon">🌡️</div>

    <h1>Temperature Converter</h1>

    <p class="subtitle">Convert Celsius, Fahrenheit & Kelvin</p>

    <input type="number" id="temp" placeholder="Enter Temperature">

    <select id="unit">
        <option value="CF">Celsius → Fahrenheit</option>
        <option value="CK">Celsius → Kelvin</option>
        <option value="FC">Fahrenheit → Celsius</option>
        <option value="FK">Fahrenheit → Kelvin</option>
        <option value="KC">Kelvin → Celsius</option>
        <option value="KF">Kelvin → Fahrenheit</option>
    </select>

    <button onclick="convert()">Convert Temperature</button>

    <div class="result" id="result">Result Here</div>

</div>

<script>

const formulas = {
    CF: t => `${((t * 9/5) + 32).toFixed(2)} °F`,
    CK: t => `${(t + 273.15).toFixed(2)} K`,
    FC: t => `${((t - 32) * 5/9).toFixed(2)} °C`,
    FK: t => `${(((t - 32) * 5/9) + 273.15).toFixed(2)} K`,
    KC: t => `${(t - 273.15).toFixed(2)} °C`,
    KF: t => `${(((t - 273.15) * 9/5) + 32).toFixed(2)} °F`
};

function convert(){

    const tempValue = document.getElementById("temp").value;
    const temp = Number(tempValue);
    const unit = document.getElementById("unit").value;
    const result = document.getElementById("result");

    if(tempValue.trim() === "" || isNaN(temp)){
        result.innerHTML = "Invalid option: Enter a number";
        result.style.color = "#fb7185";
        return;
    }

    result.classList.remove("show");

    setTimeout(() => {
        result.innerHTML = formulas[unit](temp);
        result.style.color = "#a855f7";
        result.classList.add("show");
    },100);
}

document.getElementById("temp").addEventListener("keydown", e => {
    if(e.key === "Enter") convert();
});

</script>

</body>
</html>

